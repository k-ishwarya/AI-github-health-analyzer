# Environment ('development' or 'production'). In production, /docs, /redoc, and verbose error traces are disabled.
ENVIRONMENT=development

# GitHub Personal Access Token (Optional, boosts rate limit from 60 to 5,000 requests/hour)
# Generate at: https://github.com/settings/tokens (no extra permissions needed for public repos)
GITHUB_TOKEN=

# Gemini API Key (Optional, powers generative AI diagnostics)
# Get free at: https://aistudio.google.com
GEMINI_API_KEY=

# Administrative API Key (Required to access /api/admin/history and /api/admin/repository)
ADMIN_API_KEY=

# Allowed CORS Origins (comma-separated list for production deployment)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
